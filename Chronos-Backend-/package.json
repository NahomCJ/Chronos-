{
  "name": "chronos-backend",
  "version": "1.0.0",
  "description": "Backend API for Chronos project",
  "main": "dist/server.js",
  "license": "ISC",
  "author": "",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec tsx src/server.ts",
    "build": "tsc",
    "build:blockhub": "tsc -p tsconfig.blockhub.json",
    "zip:blockhub": "python scripts/zip-blockhub.py",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "generate:swagger": "tsx scripts/swagger.ts",
    "generate:postman": "tsx scripts/generatePostman.ts",
    "generate:md": "widdershins swagger.json -o docs/docs/api.md",
    "generate:docs": "cd docs && npm run build",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:crypto": "cross-env NODE_ENV=test SKIP_DB_TEST_SETUP=true jest src/modules/crypto src/modules/core/kyc/kyc.crypto-provisioning.spec.ts --runInBand",
    "test:crypto:coverage": "cross-env NODE_ENV=test SKIP_DB_TEST_SETUP=true jest src/modules/crypto src/modules/core/kyc/kyc.crypto-provisioning.spec.ts --runInBand --coverage --collectCoverageFrom='src/modules/crypto/controllers/**/*.ts' --collectCoverageFrom='src/modules/crypto/routes/**/*.ts' --collectCoverageFrom='src/modules/crypto/services/**/*.ts' --collectCoverageFrom='!src/modules/crypto/**/*.spec.ts' --collectCoverageFrom='src/modules/core/kyc/kyc.service.ts' --coverageDirectory=coverage/crypto",
    "test:paxos:sandbox": "tsx scripts/paxos-sandbox-smoke.ts",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "api"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-secrets-manager": "^3.1033.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.11.0",
    "@sentry/profiling-node": "^10.11.0",
    "@thirdweb-dev/sdk": "^4.0.0",
    "@thirdweb-dev/storage": "^2.0.0",
    "@unit-finance/unit-node-sdk": "^1.4.3",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "ethers": "^5.7.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.6",
    "openai": "^6.34.0",
    "pdfkit": "^0.17.2",
    "plaid": "^41.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zod-openapi": "^5.4.1",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^2.0.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "cross-env": "^10.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "openapi-to-postmanv2": "^5.1.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.0",
    "supertest": "^6.3.4",
    "swagger-to-postman": "^1.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "winston": "^3.17.0"
  }
}
