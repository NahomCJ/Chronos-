# ============================================================
# Chronos BlockHub — Environment Variables
# ============================================================
# NEVER commit real values. All secrets MUST come from AWS Secrets Manager.
# Copy this file to .env for local development ONLY.
# ============================================================

# App
NODE_ENV=development
PORT=3000

# Database (Neon Postgres in prod — shared with the main API, see Chronos-Backend-/.env.example)
DATABASE_URL=postgresql://postgres:password@localhost:5432/blockhub_dev

# Redis (AWS Elasticache in prod)
REDIS_URL=redis://localhost:6379

# ============================================================
# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048)
# ============================================================
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<your-private-key>\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your-public-key>\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# ============================================================
# Paxos (Sandbox)
# Obtain from: https://dashboard.sandbox.paxos.com
# OAuth2 Sandbox Token URL: https://oauth.sandbox.paxos.com/oauth2/token
# Sandbox API Base:         https://api.sandbox.paxos.com/v2
# Production API Base:      https://api.paxos.com/v2
# ============================================================
PAXOS_CLIENT_ID=<your-sandbox-client-id>
PAXOS_CLIENT_SECRET=<your-sandbox-client-secret>
# Required scopes (space-separated):
# funding:read_profile funding:write_profile
# trading:read_order trading:write_order
# identity:read_identity identity:write_identity
# transfer:read_transfer
PAXOS_SCOPES=funding:read_profile funding:write_profile trading:read_order trading:write_order identity:read_identity identity:write_identity transfer:read_transfer

# ============================================================
# Plaid (webhook receiver only — KYC handled at app login layer)
# ============================================================
PLAID_WEBHOOK_SECRET=<your-plaid-webhook-secret>

# ============================================================
# Email (SMTP)
# ============================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<your-smtp-password>
SMTP_FROM=noreply@chronos.app

# ============================================================
# Fees & Limits (overridable via env — never hardcode)
# ============================================================
FEE_RATE_DEFAULT=0.005
FEE_RATE_MIN=0.002
FEE_RATE_MAX=0.010
SPREAD_RATE=0.002

DAILY_TRADE_LIMIT_STANDARD=10000
DAILY_TRADE_LIMIT_VERIFIED_PLUS=50000
