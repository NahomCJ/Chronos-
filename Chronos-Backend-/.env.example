# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Get both connection strings from the Neon dashboard → your project → Connect.
# DATABASE_URL: the pooled connection (via PgBouncer) — use this for the app itself.
# DIRECT_URL:   the unpooled connection — Prisma needs this for migrate/db push.
# Both require sslmode=require; Neon rejects unencrypted connections.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/chronos?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/chronos?sslmode=require

# ── AI (Panther / Chris) ──────────────────────────────────────────────────────
# Server still boots without these; the endpoints that need them return a
# clear "not configured" error instead of crashing.
# DEEPSEEK_API_KEY=sk-...             # Primary LLM for every chatbot integration (Chris
#                                      # chat + all its domain agents, AI alerts, LifeX
#                                      # AI coach) — see src/modules/ai/panther/llm/llm.client.ts.
# ANTHROPIC_API_KEY=sk-ant-...        # Automatic fallback when DeepSeek is unset/unreachable/errors.
#                                      # Same chatbots as DEEPSEEK_API_KEY above.
# OPENAI_API_KEY=sk-...               # Voice transcription (Whisper) — POST /api/ai/voice/transcribe
# PANTHER_AI_URL=http://localhost:8000  # Panther AI FastAPI service — defaults to localhost:8000.
#                                      # Used by POST /api/lifex/finance/advice/analyze{,/batch}.
#
# ELEVENLABS_API_KEY=...              # Voice synthesis/transcription — shared by BOTH
#                                      # POST /api/ai/voice/synthesize (Chris FAB + Panther AI chat)
#                                      # and POST /api/lifex/ai/voice/{text,audio} (LifeX AI coach).
#                                      # `XI_API_KEY` also works as an alias for this same var.
# Check GET /api/ai/voice/health (auth required) to verify the key is valid
# and hasn't hit its monthly character quota, without spending characters.
#
# Optional — every one of these has a sane default (see
# src/modules/ai/voice/elevenlabs.client.ts), only set if you want to change it:
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM        # Defaults to the "Rachel" voice
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_VOICE_STABILITY=0.45
# ELEVENLABS_VOICE_SIMILARITY_BOOST=0.8
# ELEVENLABS_VOICE_STYLE=0.25
# ELEVENLABS_SPEAKER_BOOST=true
#
# Only needed for the LifeX AI coach's ElevenLabs Agent widget
# (POST /api/lifex/ai/voice/signed-url, public/chronos-voice-chat.html):
# ELEVENLABS_AGENT_ID=agent_...
# CHRONOS_VOICE_CHAT_URL=              # Proxy voice turns to another chat service instead of LifeAiService.coachReply()
# CHRONOS_VOICE_CHAT_AUTH_TOKEN=       # Bearer token for CHRONOS_VOICE_CHAT_URL, if set
# CHRONOS_VOICE_JSON_LIMIT=25mb        # Body size limit for base64 audio uploads to /api/lifex/ai/voice/audio

# ── Plaid Sandbox ─────────────────────────────────────────────────────────────
# Obtain from https://dashboard.plaid.com → Team Settings → Keys
# Leave commented until keys are issued — the server will warn but not crash.
#
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_sandbox_secret
# PLAID_ENV=sandbox
#
# IDV template ID — create one at Plaid Dashboard → Identity Verification
# PLAID_IDV_TEMPLATE_ID=idvtmpl_xxxxxxxxxx
#
# Set to "true" to enforce Plaid webhook JWT signature verification.
# Requires the `jose` npm package to be installed for full JWK verification.
# PLAID_VERIFY_WEBHOOKS=false

# ── Paxos Sandbox (BlockHub Crypto Trading) ──────────────────────────────────
# Obtain from https://dashboard.sandbox.paxos.com.
# Server still boots without these; price reads fall back to CoinGecko and
# trading/wallet provisioning return 503 until credentials are configured.
PAXOS_ENV=sandbox
# PAXOS_CLIENT_ID=your_paxos_sandbox_client_id
# PAXOS_CLIENT_SECRET=your_paxos_sandbox_client_secret
# PAXOS_PROFILE_ID=your_platform_profile_id
# PAXOS_SETTLEMENT_PROFILE_ID=your_settlement_profile_id
# PAXOS_SCOPES=funding:read_profile funding:write_profile trading:read_order trading:write_order identity:read_identity identity:write_identity transfer:read_transfer transfer:write_internal_transfer
# PAXOS_SANDBOX_RUN_TRADES=false
# PAXOS_SANDBOX_RUN_TRANSFERS=false
# PAXOS_SANDBOX_TRADE_AMOUNT_USD=5.00

# ── BlockHub Trading Config ──────────────────────────────────────────────────
FEE_RATE_DEFAULT=0.005
SPREAD_RATE=0.002
DAILY_TRADE_LIMIT_STANDARD=10000
DAILY_TRADE_LIMIT_VERIFIED_PLUS=50000
PAXOS_ORDER_POLL_INTERVAL_MS=2000
PAXOS_ORDER_POLL_ATTEMPTS=15

# ── Deposit ───────────────────────────────────────────────────────────────────
DEPOSIT_MIN_AMOUNT=1

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# SENTRY_DSN=
