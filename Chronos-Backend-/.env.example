# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/chronos

# ── Plaid Sandbox ─────────────────────────────────────────────────────────────
# Obtain from https://dashboard.plaid.com → Team Settings → Keys
# Leave commented until keys are issued — the server will warn but not crash.
#
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_sandbox_secret
# PLAID_ENV=sandbox
#
# IDV template ID — create one at Plaid Dashboard → Identity Verification
# PLAID_IDV_TEMPLATE_ID=idvtmpl_xxxxxxxxxx
#
# Set to "true" to enforce Plaid webhook JWT signature verification.
# Requires the `jose` npm package to be installed for full JWK verification.
# PLAID_VERIFY_WEBHOOKS=false

# ── Paxos Sandbox (BlockHub Crypto Trading) ──────────────────────────────────
# Obtain from https://dashboard.sandbox.paxos.com.
# Server still boots without these; price reads fall back to CoinGecko and
# trading/wallet provisioning return 503 until credentials are configured.
PAXOS_ENV=sandbox
# PAXOS_CLIENT_ID=your_paxos_sandbox_client_id
# PAXOS_CLIENT_SECRET=your_paxos_sandbox_client_secret
# PAXOS_PROFILE_ID=your_platform_profile_id
# PAXOS_SETTLEMENT_PROFILE_ID=your_settlement_profile_id
# PAXOS_SCOPES=funding:read_profile funding:write_profile trading:read_order trading:write_order identity:read_identity identity:write_identity transfer:read_transfer transfer:write_internal_transfer
# PAXOS_SANDBOX_RUN_TRADES=false
# PAXOS_SANDBOX_RUN_TRANSFERS=false
# PAXOS_SANDBOX_TRADE_AMOUNT_USD=5.00

# ── BlockHub Trading Config ──────────────────────────────────────────────────
FEE_RATE_DEFAULT=0.005
SPREAD_RATE=0.002
DAILY_TRADE_LIMIT_STANDARD=10000
DAILY_TRADE_LIMIT_VERIFIED_PLUS=50000
PAXOS_ORDER_POLL_INTERVAL_MS=2000
PAXOS_ORDER_POLL_ATTEMPTS=15

# ── Deposit ───────────────────────────────────────────────────────────────────
DEPOSIT_MIN_AMOUNT=1

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# SENTRY_DSN=
