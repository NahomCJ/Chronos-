enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  FILLED
  FAILED
}

enum RevenueType {
  TRADE_FEE
  SPREAD
}

model CryptoWallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  paxosCustomerId  String
  paxosWalletId    String   @unique
  nftWalletAddress String? // Added for NFT module
  userIndex        Int      @default(0) // Added for NFT module
