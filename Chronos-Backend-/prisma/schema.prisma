}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  amount    Decimal? @db.Decimal(18, 2)
  asset     String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============================================
// CHRONOS NFT (BlockHub) MODELS
// ============================================

enum NftStandard {
  ERC721
  ERC1155
}

enum NftStatus {
  MINTED
  LISTED
  SOLD
  BURNED
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

model NftContract {
  id              String   @id @default(uuid())
  name            String
  symbol          String?
  standard        NftStandard @default(ERC721)
  contractAddress String   @unique
  chain           String   @default("polygon")
  ownerUserId     String?
  royaltyBps      Int      @default(500)
  deployTxHash    String?
  isActive        Boolean  @default(true)
  deployedAt      DateTime?
  // Marketplace display metadata — collections had no cover image, blurb,
  // curation flag, or category before this; the Flutter marketplace page
  // was showing fully hardcoded content because of it.
  imageUrl        String?
  description     String?
  isFeatured      Boolean  @default(false)
  category        String   @default("ART") // ART | COLLECTIBLES | MUSIC
  nfts            Nft[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Nft {
  id            String   @id @default(uuid())
  tokenId       String
  contractId    String
  ownerUserId   String
  creatorUserId String
  name          String
  description   String?
  imageUrl      String?
  metadataUrl   String?
  attributes    Json     @default("[]")
  status        NftStatus @default(MINTED)
  isFavoritedBy String[] @default([])
  mintedAt      DateTime?

  contract      NftContract @relation(fields: [contractId], references: [id])
  owner         User        @relation("NftOwner", fields: [ownerUserId], references: [id])
  creator       User        @relation("NftCreator", fields: [creatorUserId], references: [id])
  listings      NftListing[]
  transactions  NftTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contractId])
  @@index([ownerUserId])
}

model NftListing {
  id                String        @id @default(uuid())
  nftId             String
  sellerUserId      String
  priceAmount       Decimal       @db.Decimal(30, 18)
  priceCurrency     String        @default("ETH")
  listingType       String        @default("FIXED")
  status            ListingStatus @default(ACTIVE)
  thirdwebListingId String?
  expiresAt         DateTime?

  nft               Nft           @relation(fields: [nftId], references: [id])
  seller            User          @relation(fields: [sellerUserId], references: [id])
  transactions      NftTransaction[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([nftId])
  @@index([sellerUserId])
}

model NftTransaction {
  id                String            @id @default(uuid())
  nftId             String
  listingId         String?
  buyerUserId       String
  sellerUserId      String
  salePrice         Decimal           @db.Decimal(30, 18)
  platformFee       Decimal           @db.Decimal(30, 18)
  royaltyAmount     Decimal           @db.Decimal(30, 18) @default(0)
  sellerNet         Decimal           @db.Decimal(30, 18)
  currency          String            @default("ETH")
  paxosDebitTxId    String?
  paxosCreditTxId   String?
  onchainTxHash     String?
  status            TransactionStatus @default(PENDING)

  nft               Nft               @relation(fields: [nftId], references: [id])
  listing           NftListing?       @relation(fields: [listingId], references: [id])
  buyer             User              @relation("NftBuyer", fields: [buyerUserId], references: [id])
  seller            User              @relation("NftSeller", fields: [sellerUserId], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([nftId])
  @@index([buyerUserId])
  @@index([sellerUserId])
}

model RoyaltyPayment {
  id               String   @id @default(uuid())
  nftTransactionId String?
  creatorUserId    String
  amount           Decimal  @db.Decimal(30, 18)
  currency         String   @default("ETH")
  paxosTxId        String?
  paidAt           DateTime?
  createdAt        DateTime @default(now())

  creator User @relation(fields: [creatorUserId], references: [id])

  @@index([nftTransactionId])
  @@index([creatorUserId])
}

model NftMintRecord {
  id            String   @id @default(uuid())
  nftId         String?
  creatorUserId String
  jobId         String   @unique
  status        String   @default("PENDING")
  onchainTxHash String?
  ipfsMetadata  String?
  ipfsAsset     String?
  mintFee       Decimal  @db.Decimal(30, 18) @default(0)
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator User @relation(fields: [creatorUserId], references: [id])

  @@index([creatorUserId])
  @@index([jobId])
  @@index([status])
}

model NftAuditLog {
  id        String   @id @default(uuid())
  userId    String
  event     String
  nftId     String?
  payload   Json     @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([nftId])
  @@index([createdAt])
}

