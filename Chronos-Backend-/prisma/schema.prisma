// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================
// ENUMS
// ==========================

enum CardType {
  VIRTUAL
  PHYSICAL
  CRYPTO
  DISPOSABLE
}

enum CardStatus {
  ACTIVE
  BLOCKED
  FROZEN
  EXPIRED
}

enum TickPayAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TickPayTransactionType {
  PURCHASE
  REPAYMENT
  REFUND
  FEE
  ADJUSTMENT
}

enum TickPayTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TickPayFeeStatus {
  SCHEDULED
  DUE
  PAID
  MISSED
  CANCELLED
  WAIVED
}

enum PlanFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanStatus {
  ACTIVE
  PAID
  OVERDUE
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum GoalCategory {
  CAREER
  PERSONAL
  FINANCE
  HEALTH
  SOCIAL
  SPIRITUAL
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  MISSED
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum HabitStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum MentorshipStatus {
  UPCOMING
  COMPLETED
  CANCELED
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum CommunityCategory {
  CAREER
  PERSONAL
  HEALTH
  SOCIAL
  SPIRITUAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ==========================
// ENUMS (Core Banking)
// ==========================

// Account
enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  INVESTMENT
}


// Wallet
enum WalletType {
  FIAT
  CRYPTO
  STABLECOIN
  SYSTEM
  ESCROW
  SETTLEMENT
  FEE_POOL
}

enum WalletStatus {
  ACTIVE
  INACTIVE
  FROZEN
}

// Transaction
enum CoreTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PURCHASE
  PAYMENT
  REPAYMENT
  FEE
  ADJUSTMENT
}

enum TransactionStatus {
  INITIATED // created but not posted
  PENDING // waiting for processing
  COMPLETED
  FAILED
  CANCELLED
}

// Ledger Entry
enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerCategory {
  TRANSFER
  FEE
  FX
  ADJUSTMENT
  DONATION
  PURCHASE
  HSA
}

enum FxOrderStatus {
  QUOTED
  LOCKED
  EXECUTED
  FAILED
  EXPIRED
  CANCELLED
}

// Transfer
enum TransferStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// ==========================
// MODELS
// ==========================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  firstName       String
  middleName      String?
  lastName        String
  phone           String?   @unique
  isEmailVerified Boolean   @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  role            Role      @default(USER)
  tier            String    @default("standard")
  userLevel       UserLevel @default(BEGINNER)
  faith           String? // captured during onboarding, used by LifeX Spiritual
  backgroundUrl       String? // user-chosen app-wide background (Pexels photo or video URL)
  backgroundMediaType String? // "photo" | "video"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ---------------- Core Banking ----------------
  bankingProfile   BankingProfile? // 1:1
  accounts         Account[] // 1:M
  coreTransactions CoreTransaction[] // all transactions initiated by user
  transfers        Transfer[] // all transfers initiated by user

  // ---------------- Legacy / Other Modules ----------------
  fxOrders                FxOrder[]
  tickPayAccount          TickPayAccount?
  tickPayOnboarding       TickPayOnboarding?
  enrollments             Enrollment[]
  scholarshipApplications ScholarshipApplication[]
  tutorSessions           TutorSession[]
  studentLoans            StudentLoan[]
  financialPlans          FinancialPlan[]
  transactions            Transaction[] // legacy transactions
  loans                   Loan[]
  investmentAdvice        InvestmentAdvice[]
  creditScores            CreditScore[]
  habits                  Habit[]
  billPayments            BillPayment[]

  // ---------------- BlockHub (Crypto & NFT) ----------------
  cryptoWallet            CryptoWallet?
  trades                  Trade[]
  portfolio               PortfolioHolding[]
  revenues                Revenue[]
  auditLogs               AuditLog[]

  nftsOwned               Nft[]            @relation("NftOwner")
  nftsCreated             Nft[]            @relation("NftCreator")
  nftListings             NftListing[]
  nftPurchases            NftTransaction[] @relation("NftBuyer")
  nftSales                NftTransaction[] @relation("NftSeller")
  royaltyPayments         RoyaltyPayment[]
  nftMintRecords          NftMintRecord[]
  nftAuditLogs            NftAuditLog[]
  aiAlerts                AiAlert[]
  notifications           Notification[]

  // ---------------- Auto-Invest with Chris ----------------
  autoInvestPlans         AutoInvestPlan[]
}

enum Role {
  USER
  ADMIN
}

enum UserLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ============================================
// ACCOUNTS
// ============================================

// ==========================
// ACCOUNTS & WALLET (Ledger-first)
// ==========================

model Account {
  id            String        @id @default(uuid())
  userId        String
  accountNumber String        @unique
  type          AccountType
  status        AccountStatus @default(DRAFT)
  tier          String        @default("basic")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User            @relation(fields: [userId], references: [id])
  wallets          Wallet[]
  bankingProfileId String?
  bankingProfile   BankingProfile? @relation(fields: [bankingProfileId], references: [id])

  cards Card[]

  @@index([userId])
}
model BankingProfile {
  id          String        @id @default(uuid())
  userId      String        @unique
  status      AccountStatus @default(DRAFT)
  kycVerified Boolean       @default(false)
  riskLevel   RiskLevel?
  frozen      Boolean       @default(false)

  // Plaid Identity Verification (KYC)
  plaidIdvId     String?
  plaidStatus    String?

  // Plaid Auth (bank account linking for ACH deposits)
  plaidAccessToken String?
  plaidItemId      String?
  plaidAccountId   String?

  // Unit BaaS
  unitCustomerId        String?
  unitApplicationId     String?
  unitApplicationStatus String?

  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  accounts     Account[]
  unitAccounts UnitAccount[]
  unitCards    UnitCard[]
  unitTransfers UnitTransfer[]
}

// ==========================
// UNIT BAAS MODELS
// ==========================

model UnitAccount {
  id               String   @id @default(uuid())
  bankingProfileId String
  unitAccountId    String   @unique
  routingNumber    String
  accountNumber    String
  depositProduct   String   @default("checking")
  balance          Int      @default(0) // stored in cents
  status           String   @default("open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bankingProfile BankingProfile @relation(fields: [bankingProfileId], references: [id])
  unitCards      UnitCard[]
  unitTransfers  UnitTransfer[]

  @@index([bankingProfileId])
}

model UnitCard {
  id               String   @id @default(uuid())
  bankingProfileId String
  unitAccountId    String
  unitCardId       String   @unique
  last4            String
  type             String   @default("VIRTUAL")
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bankingProfile BankingProfile @relation(fields: [bankingProfileId], references: [id])
  unitAccount    UnitAccount    @relation(fields: [unitAccountId], references: [unitAccountId])

  @@index([bankingProfileId])
  @@index([unitAccountId])
}

model UnitTransfer {
  id               String   @id @default(uuid())
  bankingProfileId String
  unitAccountId    String
  unitTransferId   String   @unique
  type             String   // ACH | WIRE | BOOK
  direction        String   @default("Debit")
  amount           Int      // in cents
  description      String?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bankingProfile BankingProfile @relation(fields: [bankingProfileId], references: [id])
  unitAccount    UnitAccount    @relation(fields: [unitAccountId], references: [unitAccountId])

  @@index([bankingProfileId])
  @@index([unitAccountId])
}

enum AccountStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Wallet {
  id        String       @id @default(uuid())
  accountId String
  currency  String
  type      WalletType
  status    WalletStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account       Account       @relation(fields: [accountId], references: [id])
  ledger        LedgerEntry[]
  transfersFrom Transfer[]    @relation("TransferFrom")
  transfersTo   Transfer[]    @relation("TransferTo")
  card          Card[]
  // Opposite relation fields for FX orders
  fxOrdersFrom  FxOrder[]     @relation("FxFromWallet")
  fxOrdersTo    FxOrder[]     @relation("FxToWallet")

  @@unique([accountId, currency, type])
  @@index([accountId])
}

model BillProvider {
  id        String   @id @default(uuid())
  name      String
  category  String
  createdAt DateTime @default(now())

  payments BillPayment[]
}

model BillPayment {
  id String @id @default(uuid())

  userId     String
  providerId String

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider BillProvider @relation(fields: [providerId], references: [id])

  amount    Float
  reference String        @unique
  status    PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
}

// ==========================
// CORE TRANSACTION + LEDGER
// ==========================

model CoreTransaction {
  userId String
  user   User   @relation(fields: [userId], references: [id])

  id        String              @id @default(uuid())
  type      CoreTransactionType
  status    TransactionStatus   @default(INITIATED)
  reference String?             @unique
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfer      Transfer?
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String
  walletId      String
  direction     LedgerDirection
  category      LedgerCategory
  amount        Decimal         @db.Decimal(30, 8)
  currency      String
  reference     String?
  createdAt     DateTime        @default(now())

  transaction CoreTransaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet          @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([transactionId])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  userId      String?
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())
}

// ==========================
// TRANSFERS (Wallet-to-Wallet)
// ==========================

model Transfer {
  userId String
  user   User   @relation(fields: [userId], references: [id])

  id            String         @id @default(uuid())
  transactionId String         @unique
  fromWalletId  String
  toWalletId    String
  toExternal    Json?
  amount        Decimal        @db.Decimal(30, 8)
  currency      String
  fee           Decimal        @default(0) @db.Decimal(30, 8)
  status        TransferStatus
  reference     String?        @unique
  note          String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  transaction CoreTransaction @relation(fields: [transactionId], references: [id])
  fromWallet  Wallet          @relation("TransferFrom", fields: [fromWalletId], references: [id])
  toWallet    Wallet          @relation("TransferTo", fields: [toWalletId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([transactionId])
}

// ============================================
// FX ORDERS
// ============================================

model FxOrder {
  id           String        @id @default(cuid())
  userId       String
  fromWalletId String
  toWalletId   String
  side         String
  buyCurrency  String
  sellCurrency String
  buyAmount    Decimal?      @db.Decimal(18, 6)
  sellAmount   Decimal?      @db.Decimal(18, 6)
  rate         Decimal?      @db.Decimal(18, 10)
  provider     String
  providerRef  String?
  status       FxOrderStatus @default(QUOTED)
  expiresAt    DateTime?
  meta         Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  fromWallet Wallet @relation("FxFromWallet", fields: [fromWalletId], references: [id])
  toWallet   Wallet @relation("FxToWallet", fields: [toWalletId], references: [id])
  user       User   @relation(fields: [userId], references: [id])
}

// ============================================
// CARDS
// ============================================

model Card {
  id           String     @id @default(uuid())
  accountId    String
  brand        String
  last4        String
  type         CardType
  status       CardStatus @default(ACTIVE)
  walletId     String?
  panToken     String?
  pinHash      String?
  dailyLimit   Decimal?   @db.Decimal(30, 8)
  monthlyLimit Decimal?   @db.Decimal(30, 8)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  account     Account      @relation(fields: [accountId], references: [id])
  wallet      Wallet?      @relation(fields: [walletId], references: [id])
  tickPayCard TickPayCard? @relation("CardToTickPayCard")
}

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExchangeRate {
  id            String   @id @default(uuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal
  provider      String // must be added
  createdAt     DateTime @default(now()) // renamed from timestamp

  @@index([baseCurrency, quoteCurrency])
}

// ==========================
// TICKPAY MODELS (UPDATED)
// ==========================
/// Add to prisma/schema.prisma (near other TickPay models)

model TickPayOnboarding {
  id                 String   @id @default(cuid())
  userId             String   @unique
  employmentStatus   String
  employerName       String?
  monthlySalary      Decimal? @db.Decimal(30, 8)
  incomeFrequency    String?
  primaryIncomeSrc   String?
  secondaryIncome    Decimal? @db.Decimal(30, 8)
  bankName           String?
  accountType        String?
  monthlyRent        Decimal? @db.Decimal(30, 8)
  monthlyUtilities   Decimal? @db.Decimal(30, 8)
  otherObligations   Decimal? @db.Decimal(30, 8)
  outstandingLoans   Decimal? @db.Decimal(30, 8)
  avgMonthlySpending Decimal? @db.Decimal(30, 8)
  purpose            String?
  spendingPrefs      String?
  agreedTerms        Boolean  @default(false)
  agreedDataSharing  Boolean  @default(false)
  noRecentBankruptcy Boolean?
  score              Int? // optional scoring result (0-100)
  recommendedLimit   Decimal? @db.Decimal(30, 8)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TickPayAccount {
  id          String               @id @default(cuid())
  userId      String               @unique
  user        User                 @relation(fields: [userId], references: [id])
  creditLimit Decimal              @default("500") @db.Decimal(30, 8)
  balance     Decimal              @default("0") @db.Decimal(30, 8) // outstanding principal
  available   Decimal?             @db.Decimal(30, 8)
  status      TickPayAccountStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  transactions    TickPayTransaction[]
  feeInstallments TickPayFeeInstallment[]
  card            TickPayCard?
}

model TickPayTransaction {
  id               String                   @id @default(cuid())
  tickPayAccountId String
  tickPayAccount   TickPayAccount           @relation(fields: [tickPayAccountId], references: [id])
  type             TickPayTransactionType
  status           TickPayTransactionStatus @default(PENDING)
  amount           Decimal                  @db.Decimal(30, 8)
  currency         String                   @default("USD")
  merchant         String?
  meta             Json?
  reference        String? // external provider reference
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  feeInstallments TickPayFeeInstallment[] @relation("PurchaseFee") // ✅ this line adds the opposite relation
}

model TickPayFeeInstallment {
  id               String              @id @default(cuid())
  tickPayAccountId String
  tickPayAccount   TickPayAccount      @relation(fields: [tickPayAccountId], references: [id])
  purchaseTxId     String?
  purchaseTx       TickPayTransaction? @relation("PurchaseFee", fields: [purchaseTxId], references: [id])
  amount           Decimal             @db.Decimal(30, 8)
  status           TickPayFeeStatus    @default(SCHEDULED)
  dueDate          DateTime
  paidAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tickPayAccountId, dueDate])
}

model TickPayCard {
  id               String @id @default(cuid())
  cardId           String @unique
  tickPayAccountId String @unique

  card           Card           @relation("CardToTickPayCard", fields: [cardId], references: [id])
  tickPayAccount TickPayAccount @relation(fields: [tickPayAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TickPayAudit {
  id        String   @id @default(cuid())
  accountId String
  actorId   String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())
}

// ==========================
//lifeX (Education model)
// ==========================

model Course {
  id            String       @id @default(cuid())
  provider      String // "coursera", "udemy", "local"
  providerId    String?      @unique // id from provider when present
  title         String
  description   String?
  url           String?
  durationHours Float?
  level         String? // beginner/intermediate/advanced
  price         Decimal?     @db.Decimal(18, 4)
  currency      String?      @default("USD")
  tags          String[]     @default([])
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  enrollments   Enrollment[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String // "IN_PROGRESS","COMPLETED","PLANNED"
  progress    Float     @default(0) // 0..100
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model Scholarship {
  id          String    @id @default(cuid())
  provider    String
  title       String
  description String?
  url         String?
  country     String?
  amount      Decimal?  @db.Decimal(18, 4)
  deadline    DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications ScholarshipApplication[]
}

model ScholarshipApplication {
  id            String    @id @default(cuid())
  scholarshipId String
  userId        String
  status        String // "APPLIED","RECEIVED","AWARDED","DECLINED"
  appliedAt     DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id])
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id])
}

model Tutor {
  id           String         @id @default(cuid())
  name         String
  bio          String?
  subjects     String[]       @default([])
  rating       Float?
  pricePerHour Decimal?       @db.Decimal(18, 4)
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     TutorSession[]
}

model TutorSession {
  id              String   @id @default(cuid())
  tutorId         String
  userId          String
  scheduledAt     DateTime
  durationMinutes Int
  status          String // "SCHEDULED","COMPLETED","CANCELLED"
  notes           String?
  createdAt       DateTime @default(now())

  tutor Tutor @relation(fields: [tutorId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

model StudentLoan {
  id          String    @id @default(cuid())
  userId      String
  lender      String
  principal   Decimal   @db.Decimal(18, 4)
  outstanding Decimal   @db.Decimal(18, 4)
  ratePercent Float?
  dueDate     DateTime?
  status      String // "ACTIVE","PAID","DEFAULTED"
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ==========================
//lifeX (finacial model)
// ==========================

model FinancialPlan {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  goalName     String
  targetAmount Decimal       @db.Decimal(12, 2)
  savedAmount  Decimal       @default(0) @db.Decimal(12, 2)
  frequency    PlanFrequency
  status       PlanStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  accountId String
  type      TransactionType
  category  String
  amount    Decimal         @db.Decimal(12, 2)
  currency  String
  metadata  Json
  createdAt DateTime        @default(now())
}

model Loan {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  name              String // <-- add a name/title for the loan
  principalAmount   Decimal    @db.Decimal(12, 2)
  outstandingAmount Decimal    @db.Decimal(12, 2)
  interestRate      Decimal    @db.Decimal(5, 2)
  dueDate           DateTime
  status            LoanStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model InvestmentAdvice {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  riskProfile       String
  recommendedAssets Json
  createdAt         DateTime @default(now())
}

model CreditScore {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  score     Int
  provider  String
  checkedAt DateTime @default(now())
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Decimal
  period    String // e.g. "2025-01"
  createdAt DateTime @default(now())
}

// ==========================
//lifeX (health model)
// ==========================

model HealthMetric {
  id         String   @id @default(uuid())
  userId     String
  metricType String
  value      Float
  unit       String
  source     String   @default("manual") // manual, apple_health, fitbit, garmin, google_fit
  recordedAt DateTime @default(now())
}

model FitnessSession {
  id             String   @id @default(uuid())
  userId         String
  type           String
  duration       Int
  caloriesBurned Float
  recordedAt     DateTime @default(now())
}

model DietLog {
  id        String   @id @default(uuid())
  userId    String
  mealType  String
  calories  Float
  nutrients Json
  loggedAt  DateTime @default(now())
}

model HsaAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  balance       Float    @default(0)
  contributions Float    @default(0)
  withdrawals   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HsaTransaction {
  id           String   @id @default(uuid())
  hsaAccountId String
  type         String
  amount       Float
  currency     String
  date         DateTime @default(now())
}

model MedicalRecord {
  id          String   @id @default(uuid())
  userId      String
  recordType  String
  description String
  documentUrl String?
  recordedAt  DateTime @default(now())
}

model WellnessProgram {
  id          String   @id @default(uuid())
  title       String
  description String
