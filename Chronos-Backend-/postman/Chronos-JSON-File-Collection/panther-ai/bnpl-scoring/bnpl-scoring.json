{
  "info": {
    "name": "Panther AI — BNPL Scoring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TickPay Affordability Score",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 250,\n  \"merchant\": \"Apple Store\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://chronos.us-east-1.elasticbeanstalk.com/api/ai/tickpay/affordability"
      }
    },
    {
      "name": "Marketplace Search",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"iPhone 15\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://chronos.us-east-1.elasticbeanstalk.com/api/ai/tickpay/search"
      }
    }
  ]
}
