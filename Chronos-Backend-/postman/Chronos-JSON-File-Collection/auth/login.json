{
  "info": {
    "name": "Auth — Login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if ([200,201].includes(pm.response.code)) {",
              "  var j = pm.response.json();",
              "  if (j.token) { pm.collectionVariables.set('token', j.token); }",
              "  if (j.refreshToken) { pm.collectionVariables.set('refreshToken', j.refreshToken); }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@chronos.app\",\n  \"password\": \"Password123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://chronos.us-east-1.elasticbeanstalk.com/api/v1/auth/login"
      }
    }
  ]
}
