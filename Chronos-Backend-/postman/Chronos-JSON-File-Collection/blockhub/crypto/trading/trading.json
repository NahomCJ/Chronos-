{
  "info": {
    "name": "BlockHub — Crypto / Trading",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Buy Crypto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"asset\": \"BTC\",\n  \"amountUsd\": 100,\n  \"walletId\": \"{{walletId}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "http://blockhub-env.us-east-1.elasticbeanstalk.com/api/v1/trade/buy"
      }
    },
    {
      "name": "Sell Crypto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"asset\": \"ETH\",\n  \"quantity\": 0.05,\n  \"walletId\": \"{{walletId}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "http://blockhub-env.us-east-1.elasticbeanstalk.com/api/v1/trade/sell"
      }
    }
  ]
}
