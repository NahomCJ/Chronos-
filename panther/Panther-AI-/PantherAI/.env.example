# Panther AI Environment Variables Example
# Copy this file to .env and fill in the actual values. DO NOT COMMIT .env to version control.

# --- Core Settings ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- AI Models ---
OPENAI_API_KEY=sk-proj-... # Get from 1Password or ask Admin
ANTHROPIC_API_KEY=sk-ant-... # Get from 1Password or ask Admin

# --- Database ---
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=ey... # Get from 1Password or ask Admin

# --- Chris / Ollama ---
CHRIS_MODEL=qwen3.5:latest
CHRIS_OLLAMA_HOST=http://localhost:11434

# --- Voice Layer (B1/B2) — ElevenLabs ---
ELEVEN_API_KEY=sk_your_elevenlabs_key_here    # ElevenLabs API key
ELEVEN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb         # Voice ID for Kevin (George default)
ELEVEN_TTS_MODEL=eleven_turbo_v2_5            # TTS model — turbo = low latency for conversation
ELEVEN_STT_MODEL=scribe_v1                    # STT model — Scribe for transcription

# --- Cross-service (B6/B12) ---
BLOCKHUB_URL=http://localhost:3002              # BlockHub Node.js backend
CHRONOS_BACKEND_URL=http://localhost:3001       # Chronos Node.js backend
CHRONOS_INTERNAL_TOKEN=                        # Shared service-to-service token

# --- Model path ---
PANTHER_MODEL_PATH=services/TC-TransactionClassifier/models/distilbert_v1_colab/
