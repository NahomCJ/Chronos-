# Panther AI Environment Variables Example
# Copy this file to .env and fill in the actual values. DO NOT COMMIT .env to version control.

# --- Core Settings ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- AI Models ---
OPENAI_API_KEY=sk-proj-... # Get from 1Password or ask Admin
ANTHROPIC_API_KEY=sk-ant-... # Get from 1Password or ask Admin

# --- Database ---
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=ey... # Get from 1Password or ask Admin

# --- Plaid (banking, investments, liabilities) ---
PLAID_CLIENT_ID=              # Get from 1Password or ask Admin
PLAID_SECRET=                 # Get from 1Password or ask Admin
PLAID_ENV=sandbox             # sandbox | development | production

# --- Chris / Ollama ---
CHRIS_MODEL=qwen3.5:latest
CHRIS_OLLAMA_HOST=http://localhost:11434

# --- Voice Layer (B1/B2) ---
# VibeVoice (local, free) — requires: git clone https://github.com/microsoft/VibeVoice && pip install -e .[streamingtts]
VIBEVOICE_ASR_ENABLED=false                          # true = use VibeVoice-ASR for transcription
VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR          # HF model ID for ASR (7B, needs GPU)
VIBEVOICE_TTS_ENABLED=false                          # true = use VibeVoice-Realtime for speech
VIBEVOICE_TTS_MODEL=microsoft/VibeVoice-Realtime-0.5B # HF model ID for TTS (0.5B)
VIBEVOICE_SPEAKER=carter                             # voice preset name (see VibeVoice demo/voices/)
VIBEVOICE_VOICE_DIR=/path/to/VibeVoice/demo/voices/streaming_model  # path to .pt voice files

# Cloud TTS/STT fallbacks (used when VibeVoice is disabled or unavailable)
ELEVENLABS_API_KEY=your-elevenlabs-key          # ELEVEN_API_KEY and XI_API_KEY are supported aliases
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM        # Rachel — Chris's established voice
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2     # Current model; v1 models were removed July 9, 2026
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# OpenAI key doubles as Whisper STT + TTS fallback (already set above)

# --- Cross-service (B6/B12) ---
BLOCKHUB_URL=http://localhost:3002              # BlockHub Node.js backend
CHRONOS_BACKEND_URL=http://localhost:3001       # Chronos Node.js backend
CHRONOS_INTERNAL_TOKEN=                        # Shared service-to-service token

# --- Model path ---
PANTHER_MODEL_PATH=services/TC-TransactionClassifier/models/distilbert_v1_colab/
