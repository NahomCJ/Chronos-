{
  "forgot_password": {
    "success": {
      "description": "Valid email provided, OTP sent",
      "endpoint": "/api/v1/auth/password/forgot",
      "request_body": { "email": "abrham@example.com" },
      "response_code": 200,
      "response_body": {
        "status": "pending",
        "message": "Password reset OTP sent",
        "data": {
          "expiresIn": 300
        }
      }
    },
    "error_not_found": {
      "description": "Email does not exist in the system",
      "response_code": 404,
      "response_body": {
        "status": "error",
        "message": "User with this email not found"
      }
    }
  },
  "reset_password": {
    "success": {
      "description": "Password successfully updated",
      "endpoint": "/api/v1/auth/password/reset",
      "response_code": 200,
      "response_body": {
        "status": "success",
        "message": "Password reset successfully"
      }
    },
    "error_mismatch": {
      "description": "New password and confirmation do not match",
      "response_code": 400,
      "response_body": {
        "status": "error",
        "message": "Passwords do not match"
      }
    },
    "error_weak_password": {
      "description": "Password does not meet security requirements",
      "response_code": 400,
      "response_body": {
        "status": "error",
        "message": "Password too weak. Use at least 8 characters, a number, and a symbol."
      }
    }
  },
  "global_auth_errors": {
    "rate_limited": {
      "response_code": 429,
      "response_body": {
        "status": "error",
        "message": "Too many attempts. Try again later."
      }
    },
    "account_suspended": {
      "response_code": 403,
      "response_body": {
        "status": "error",
        "message": "Account suspended. Contact support."
      }
    }
  },
  "mock_triggers": {
    "email_triggers": {
      "abrham@example.com": "success",
      "unknown@example.com": "error_not_found",
      "blocked@example.com": "account_suspended",
      "spam@example.com": "rate_limited"
    },
    "password_triggers": {
      "mismatch": "error_mismatch",
      "123": "error_weak_password"
    }
  }
}